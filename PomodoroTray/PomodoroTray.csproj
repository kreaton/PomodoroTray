<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PomodoroTray</AssemblyName>
    <RootNamespace>PomodoroTray</RootNamespace>
    <StartupObject>PomodoroTray.Program</StartupObject>
    <ApplicationIcon>pomodoro_clock_icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="pomodoro_clock_icon.ico" />
    <EmbeddedResource Include="preview_master.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

</Project>
