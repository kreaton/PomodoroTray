<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PomodoroTray</AssemblyName>
    <RootNamespace>PomodoroTray</RootNamespace>
    <StartupObject>PomodoroTray.Program</StartupObject>
    <ApplicationIcon>pomodoro_clock_icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="pomodoro_clock_icon.ico" />
    <EmbeddedResource Include="preview_master.png" />
  </ItemGroup>

  <!-- Bundled transition sounds; copied next to the exe so the Velopack installer ships them -->
  <ItemGroup>
    <None Update="Sounds\*.wav" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.3.39-g8d2844f" />
  </ItemGroup>

</Project>
